# Service Settings
PROJECT_NAME="Odoo ISO Reference Embedding Service"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=14251
DEBUG=True

# Qdrant Vector DB Settings
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME="odoo_iso_references"

# Embedding Model Settings
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_VECTOR_SIZE=384

# LLM Extractor (Ollama Gemma3:12b)
OLLAMA_HOST="http://localhost:11434"
LLM_MODEL="gemma3:12b"
EXTRACTION_PASSES=1
LLM_TEMPERATURE=0.1

# PDF Parser Configuration
MAX_WINDOW_CHARS=1800
MIN_PAGE_TEXT_CHARS=40
OCR_DPI=200
