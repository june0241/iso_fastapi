[Unit]
Description=FastAPI Odoo ISO Reference Embedding Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/iso_fastapi
Environment="PATH=/var/www/iso_fastapi/venv/bin"
EnvironmentFile=/var/www/iso_fastapi/.env
ExecStart=/var/www/iso_fastapi/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 14251 --workers 2

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
