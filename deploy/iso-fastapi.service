[Unit]
Description=FastAPI Odoo ISO Reference Embedding Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/iso_fastapi/iso_fastapi
Environment="PATH=/opt/iso_fastapi/venv/bin:/opt/iso_fastapi/iso_fastapi/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/opt/iso_fastapi/iso_fastapi/.env
ExecStart=/opt/iso_fastapi/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 14251 --workers 2

# Automatic Restart
Restart=always
RestartSec=5

# Logging to /var/log/iso_fastapi/iso_fastapi.log
StandardOutput=append:/var/log/iso_fastapi/iso_fastapi.log
StandardError=append:/var/log/iso_fastapi/iso_fastapi.log

[Install]
WantedBy=multi-user.target
